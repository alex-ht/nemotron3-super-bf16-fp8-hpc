# Default FP8 PTQ: conservative Mamba-MoE recipe (Model Optimizer via Megatron-Bridge)
# Docs: https://docs.nvidia.com/nemo/megatron-bridge/latest/models/nemotron/nemotron3-super.html
#       https://docs.nvidia.com/nemotron/latest/nemotron/super3/quantization.html

EXPORT_QUANT_CFG=mamba_moe_fp8_conservative
CALIB_SIZE=256

HF_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16

# Typical multi-node H100 layout (2 nodes × 8 GPUs). Adjust to your allocation.
NNODES=2
GPUS_PER_NODE=8
TP=8
PP=2
EP=8
ETP=1

# Export parallelism (official examples often use higher PP for export)
EXPORT_TP=1
EXPORT_PP=8
EXPORT_EP=1
EXPORT_ETP=1
EXPORT_DTYPE=bfloat16

NGC_IMAGE=nvcr.io/nvidia/nemo:26.02.nemotron_3_super
MEGATRON_BRIDGE_ROOT=/opt/Megatron-Bridge

# Override these on the cluster (or in .env):
# REPO_ROOT=...
# WORKSPACE=...
# MODEL_DIR=...
# HF_HOME=...
# MEGATRON_SAVE_PATH=...
# EXPORT_DIR=...
# SIF_PATH=...
# SLURM_PARTITION=...
# SLURM_ACCOUNT=...
