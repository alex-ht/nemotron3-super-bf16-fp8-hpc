# Copy to .env and adjust for your cluster. Do NOT commit .env.
# Source via: set -a; source .env; set +a
# Or pass CONFIG=configs/fp8_conservative.env to scripts / sbatch.

# --- Paths (host paths; bind-mounted into the container) ---
REPO_ROOT=/path/to/nemotron3-super-bf16-fp8-hpc
WORKSPACE=/path/to/workspace
MODEL_DIR=/path/to/models
HF_HOME=/path/to/hf_home
MEGATRON_SAVE_PATH=/path/to/megatron_ckpt/fp8
EXPORT_DIR=/path/to/hf_export/fp8
SIF_PATH=/path/to/nemo_26.02.nemotron_3_super.sif
LOG_DIR=${REPO_ROOT}/logs
SCRATCH_DIR=${REPO_ROOT}/scratch

# Optional: host Megatron-Bridge checkout (super-v3) mounted over /opt/Megatron-Bridge
# MEGATRON_BRIDGE_HOST=/path/to/Megatron-Bridge

# --- Model ---
# Local directory or HF id (trust-remote-code required for Nemotron)
HF_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-BF16
# Official FP8 also exists on HF if you only need inference:
# HF_MODEL_FP8_OFFICIAL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8

# Quant config: mamba_moe_fp8_conservative | mamba_moe_fp8_aggressive
EXPORT_QUANT_CFG=mamba_moe_fp8_conservative

# FP8 calibration often ~256 SFT samples (docs); script default may differ
CALIB_SIZE=256

# --- Parallelism (quantize / generate) ---
# Minimum often 2×8 H100; TP/PP/EP configurable. See README parallelism table.
NNODES=2
GPUS_PER_NODE=8
TP=8
PP=2
EP=8
ETP=1

# Export may use different PP (docs examples often use --pp 8)
EXPORT_TP=1
EXPORT_PP=8
EXPORT_EP=1
EXPORT_ETP=1
EXPORT_DTYPE=bfloat16

# --- Container ---
NGC_IMAGE=nvcr.io/nvidia/nemo:26.02.nemotron_3_super
MEGATRON_BRIDGE_ROOT=/opt/Megatron-Bridge
SINGULARITY_BIN=apptainer
# SINGULARITY_BIN=singularity

# --- Slurm ---
SLURM_PARTITION=gpu
SLURM_ACCOUNT=
SLURM_QOS=
SLURM_TIME=24:00:00
SLURM_JOB_NAME=nemotron3-fp8-ptq
SLURM_CONSTRAINT=
SLURM_RESERVATION=
SLURM_EXCLUSIVE=1
SLURM_MEM=
SLURM_CPUS_PER_TASK=
MASTER_PORT=29500

# Optional Hugging Face token for gated downloads (prefer HF_TOKEN file / module)
# HF_TOKEN=
